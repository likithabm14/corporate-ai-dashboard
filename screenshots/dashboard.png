from PIL import Image, ImageDraw

# Create image
width = 1200
height = 700

img = Image.new("RGB", (width, height), (240, 242, 246))
draw = ImageDraw.Draw(img)

# Header
draw.rectangle((0, 0, width, 80), fill=(30, 41, 59))
draw.text((30, 25), "Corporate AI Adoption Dashboard", fill="white")

# KPI Cards
cards = [
    (50, 120, 280, 230),
    (330, 120, 560, 230),
    (610, 120, 840, 230),
    (890, 120, 1120, 230)
]

for card in cards:
    draw.rectangle(card, fill=(255, 255, 255), outline=(180, 180, 180))

# Charts Area
draw.rectangle((50, 280, 570, 620), fill=(255, 255, 255))
draw.text((220, 440), "Industry Analysis Chart", fill="black")

draw.rectangle((630, 280, 1150, 620), fill=(255, 255, 255))
draw.text((820, 440), "Revenue Analysis Chart", fill="black")

# Save image
img.save("dashboard.png")

print("dashboard.png created successfully")
